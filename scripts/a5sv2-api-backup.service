[Unit]
Description=A5Sv2 API benchmark S3 backup and completion validator
After=network-online.target a5sv2-together.service a5sv2-mistral.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/a5sv2
Environment=RUN_BUCKET=a5sv2-benchmark-207423186775-us-east-2
Environment=RUN_PREFIX=runs/20260826-open-source-api-v1
ExecStart=/bin/bash /opt/a5sv2/scripts/ec2_open_source_api_backup.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
